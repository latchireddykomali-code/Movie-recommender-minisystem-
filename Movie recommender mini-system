      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "print(\"Movie Recommender Mini-System\")\n",
        "print(\"Libraries loaded successfully!\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "users = [\"Alice\", \"Bob\", \"Charlie\", \"David\"]\n",
        "\n",
        "movies = [\n",
        "    \"Inception\",\n",
        "    \"Toy Story\",\n",
        "    \"Avengers\",\n",
        "    \"Titanic\",\n",
        "    \"Interstellar\"\n",
        "]\n",
        "\n",
        "# 0 means the user has not rated that movie\n",
        "ratings = np.array([\n",
        "    [5, 4, 5, 0, 5],   # Alice\n",
        "    [5, 0, 4, 2, 5],   # Bob\n",
        "    [1, 2, 1, 5, 0],   # Charlie\n",
        "    [0, 2, 1, 5, 1]    # David\n",
        "], dtype=float)\n",
        "\n",
        "print(\"Users:\", users)\n",
        "print(\"Movies:\", movies)\n",
        "print(\"\\nRating Matrix:\")\n",
        "print(ratings)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "lPVYbNQcPoeG",
        "outputId": "3ad01752-6524-47c5-97d7-32dd92d53da8"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Users: ['Alice', 'Bob', 'Charlie', 'David']\n",
            "Movies: ['Inception', 'Toy Story', 'Avengers', 'Titanic', 'Interstellar']\n",
            "\n",
            "Rating Matrix:\n",
            "[[5. 4. 5. 0. 5.]\n",
            " [5. 0. 4. 2. 5.]\n",
            " [1. 2. 1. 5. 0.]\n",
            " [0. 2. 1. 5. 1.]]\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Replace missing ratings temporarily with 0\n",
        "R = ratings.copy()\n",
        "\n",
        "# Singular Value Decomposition\n",
        "U, S, VT = np.linalg.svd(R, full_matrices=False)\n",
        "\n",
        "print(\"Singular Values:\")\n",
        "print(np.round(S, 2))\n",
        "\n",
        "# Keep only the strongest 2 singular values\n",
        "k = 2\n",
        "\n",
        "R_low_rank = U[:, :k] @ np.diag(S[:k]) @ VT[:k, :]\n",
        "\n",
        "print(\"\\nLow-Rank Approximation:\")\n",
        "print(np.round(R_low_rank, 2))"
      ],
      "metadata": {
