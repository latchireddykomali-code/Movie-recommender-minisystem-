    {
      "cell_type": "code",
      "source": [
        "# Select user\n",
        "print(\"\\nChoose a user:\")\n",
        "for i, user in enumerate(users):\n",
        "    print(i, \"-\", user)\n",
        "\n",
        "user_index = int(input(\"\\nEnter user number (0-3): \"))\n",
        "\n",
        "# Number of recommendations\n",
        "n = int(input(\"How many movies do you want? \"))\n",
        "\n",
        "# Predicted ratings for selected user\n",
        "predictions = R_low_rank[user_index]\n",
        "\n",
        "print(\"\\nUser:\", users[user_index])\n",
        "print(\"\\nPredicted ratings:\")\n",
        "\n",
        "for movie, score in zip(movies, predictions):\n",
        "    print(f\"{movie}: {score:.2f}\")\n",
        "\n",
        "# Recommend only movies that were not already rated\n",
        "unrated = np.where(ratings[user_index] == 0)[0]\n",
        "\n",
        "recommended = sorted(\n",
        "    unrated,\n",
        "    key=lambda i: predictions[i],\n",
        "    reverse=True\n",
        ")[:n]\n",
        "\n",
        "print(\"\\nRecommended Movies:\")\n",
        "\n",
        "for i in recommended:\n",
        "    print(f\"{movies[i]} -> predicted rating: {predictions[i]:.2f}\")"
      ],
